#!/usr/bin/python3
"""Starts Squint from a source folder or from /usr/share/squint."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for base in (here, os.path.dirname(here), '/usr/share/squint'):
    if os.path.isfile(os.path.join(base, 'squint', '__init__.py')):
        sys.path.insert(0, base)
        break

from squint.app import main  # noqa: E402

sys.exit(main(sys.argv))
